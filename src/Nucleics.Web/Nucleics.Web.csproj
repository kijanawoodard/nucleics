<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <!-- As in the .NET 11 Blazor template: NavigationManager.NotFound()/NavigateTo do not throw in static SSR. -->
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
  </PropertyGroup>
  <ItemGroup>
    <!-- The site wires the three Kaizen libraries together (kaizen-hq/Kaizen.Static). The libraries do NOT reference each other. -->
    <PackageReference Include="KaizenIO.StaticSite" />
    <PackageReference Include="KaizenIO.BlogEngine" />
    <PackageReference Include="KaizenIO.Seo" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="content\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
