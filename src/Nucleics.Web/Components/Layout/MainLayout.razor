@inherits LayoutComponentBase
@inject NavigationManager Nav

<a class="skip" href="#main">Skip to content</a>

<header class="site-header">
    <a class="brand" href="/">
        <img class="mark mark-light" src="@Assets["assets/mark.svg"]" width="72" height="72" alt=""
             title="Seven shells; gaps mark uranium’s 92 electrons. Inbound neutron — controlled fission." />
        <img class="mark mark-dark" src="@Assets["assets/mark-dark.svg"]" width="72" height="72" alt=""
             title="Seven shells; gaps mark uranium’s 92 electrons. Inbound neutron — controlled fission." />
        <span class="wordmark">Nucleics</span>
    </a>
    <nav class="nav" aria-label="Primary">
        <a href="@Home#learn">Learn</a>
        <a href="@Home#argue">Argue</a>
        <a href="@Home#build">Build</a>
    </nav>
</header>

<main id="main">
    @Body
</main>

<footer class="site-footer">
    <span class="footer-brand">nucleics.org</span>
    <span class="footer-tag">Abundance through fission</span>
</footer>

@code {
    // On "/" the section links are plain "#learn" (exactly the original page); on any other page they need the "/" prefix.
    private string Home => Nav.ToBaseRelativePath(Nav.Uri).Split('?', '#')[0].Trim('/').Length == 0 ? "" : "/";
}
